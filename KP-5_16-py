<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Python — debugger pętli while i for</title><style>
:root{font-family:system-ui,Segoe UI,sans-serif;color:#e9eef8;background:#0b1220}*{box-sizing:border-box}body{margin:0}header{background:#111d32;border-bottom:1px solid #30405c;padding:25px max(18px,calc((100vw - 1150px)/2))}h1{margin:0 0 8px;font-size:clamp(23px,3vw,32px)}header p,.muted{color:#aebdd4}header p{margin:0}main{max-width:1150px;margin:24px auto;padding:0 18px}.layout{display:grid;grid-template-columns:245px minmax(0,1fr);gap:20px}.panel{background:#121e32;border:1px solid #2b3d59;border-radius:15px;padding:20px}.tasks{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}.task{padding:10px;background:#1a2a42;border:1px solid #344765;color:#fff;border-radius:8px;cursor:pointer}.task.active{background:#346de0}.task.done{border-color:#4ec8a4}.progress{height:8px;background:#2c3d56;border-radius:9px;overflow:hidden;margin:10px 0}.bar{height:100%;width:0;background:#55c5a3}.notice{background:#182943;border:1px solid #3a5378;border-radius:10px;padding:12px;margin-top:16px;color:#c8d8ef;font-size:13px;line-height:1.5}.top,.controls{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.eyebrow{font-size:13px;color:#8eb5ff;text-transform:uppercase}h2{margin:9px 0 17px}h3{font-size:16px;margin:0 0 10px}.columns{display:grid;grid-template-columns:1.1fr 1fr;gap:18px}.section{margin-top:18px}pre{background:#07101e;border:1px solid #30415a;border-radius:10px;padding:16px;overflow:auto;font:15px/1.65 Consolas,monospace;white-space:pre-wrap}#code{min-height:80px;font-size:18px;color:#bce3ff}#fullCode{color:#a8edca}label{display:block;font-size:14px;color:#c8d6e9;margin:8px 0 5px}input,textarea{width:100%;background:#091525;color:#fff;border:1px solid #425674;border-radius:8px;padding:10px;font:14px/1.5 Consolas,monospace}textarea{min-height:90px;resize:vertical}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.buttons{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}button.action{padding:11px 15px;border:0;border-radius:9px;background:#3676ee;color:white;font-weight:700;cursor:pointer}button.secondary{background:#283c5a}button.ghost{background:transparent;border:1px solid #506487}button:disabled{opacity:.35;cursor:not-allowed}.result{margin-top:15px;padding:13px;border-radius:9px;background:#0d2032;border:1px solid #315372;white-space:pre-wrap}.good{color:#71e3b2}.bad{color:#ffb5a7}.small{font-size:13px}.step{color:#8eb5ff;font-size:13px}#traceStatus{margin:10px 0;color:#adbed5;font-size:13px}@media(max-width:850px){.layout,.columns{grid-template-columns:1fr}.tasks{grid-template-columns:repeat(7,1fr)}}@media(max-width:480px){.tasks{grid-template-columns:repeat(5,1fr)}.fields{grid-template-columns:1fr}}
</style></head><body><header><h1>Python · Pętle while i for — krok po kroku</h1><p>5.16 Wczytaj dodatnią liczbę całkowitą n, a następnie n liczb całkowitych. Za pomocą pętli for policz, ile z nich jest większych od 10.</p></header><main><div class="layout"><aside class="panel"><strong>Wybierz zadanie</strong><div class="tasks" id="tasks"></div><div class="small muted" id="progressText"></div><div class="progress"><div class="bar" id="bar"></div></div><div class="notice">Klikaj <b>Następny krok</b>, aby śledzić działanie programu tak jak w debuggerze. Widzisz tylko <b>aktualną instrukcję</b> (warunek <code>if</code> razem z jego ciałem). Możesz cofać i ponownie przechodzić przez pętlę.<p>Samodzielnie wpisz historię zmiennych w <b>Pamięci</b> oraz wynik w <b>Output</b>. <b>Cały kod pokaże się dopiero po poprawnym rozwiązaniu.</b></p></div></aside><section class="panel"><div class="top"><span class="eyebrow" id="number"></span><span class="muted small" id="level"></span></div><h2 id="title"></h2><div class="columns"><div><h3>Aktualna instrukcja kodu</h3><div class="step" id="stepCount"></div><pre id="code" aria-live="polite"></pre><div class="controls"><button class="action secondary" id="prev">← Poprzedni krok</button><button class="action" id="forward">Następny krok →</button></div><div id="traceStatus" aria-live="polite"></div><h3>Input</h3><pre id="inputData"></pre></div><div><h3>Pamięć</h3><div class="fields" id="fields"></div><div class="section"><h3>Output</h3><label for="output">Wpisz wynik programu</label><textarea id="output" spellcheck="false" placeholder="Wpisz wynik..."></textarea></div></div></div><div class="buttons"><button class="action" id="check">Sprawdź odpowiedzi</button><button class="action ghost" id="clear">Wyczyść odpowiedzi</button></div><div class="result" id="result" hidden></div><div class="section" id="fullSection" hidden><h3>Pełny kod — zadanie rozwiązane poprawnie!</h3><pre id="fullCode"></pre></div></section></div></main><script>
const tasks=[
  {
    "title": "Zliczanie liczb większych od 10 — while",
    "level": "Poziom 0",
    "input": "4\n4\n12\n15\n8",
    "code": "n = int(input())\nk = 0\ni = 0\nwhile i < n:\n    x = int(input())\n    if x > 10:\n        k += 1\n    i += 1\nprint(k)",
    "memory": {"n":"4","i":"0, 1, 2, 3, 4","x":"4, 12, 15, 8","k":"0, 1, 2"},
    "output": "2\n",
    "kind": "while"
  },
  {
    "title": "Zliczanie liczb większych od 10 — for",
    "level": "Poziom 1",
    "input": "4\n4\n12\n15\n8",
    "code": "n = int(input())\nk = 0\nfor i in range(n):\n    x = int(input())\n    if x > 10:\n        k += 1\nprint(k)",
    "memory": {
      "n": "4",
      "i": "0, 1, 2, 3",
      "x": "4, 12, 15, 8",
      "k": "0, 1, 2"
    },
    "output": "2\n"
  },
];
const el=id=>document.getElementById(id);
let selected=0;
const saved=tasks.map(()=>({memory:{},output:'',done:false,step:0}));
function norm(s){return String(s).trim().replace(/\s*,\s*/g,',').replace(/\s+/g,' ')}
function outNorm(s){return String(s).replace(/\r\n/g,'\n').trimEnd()}
function trace(t){const data=t.input.trim().split(/\s+/).map(Number),n=data[0];let steps;if(t.kind==='while'){steps=[0,1,2];for(let i=0;i<n;i++){steps.push(3,4,5,7)}steps.push(3,8)}else{steps=[0,1];for(let i=0;i<n;i++){steps.push(2,3,4)}steps.push(2,6)}return steps.map((line,index)=>({line,index}));}
function persist(){const s=saved[selected];document.querySelectorAll('[data-var]').forEach(e=>s.memory[e.dataset.var]=e.value);s.output=el('output').value}
function showStep(){const t=tasks[selected],s=saved[selected],steps=trace(t),current=steps[s.step],w=t.kind==='while',ifLine=w?5:4;const lines=t.code.split('\n');el('code').textContent=current.line===ifLine?lines[ifLine]+'\n'+lines[ifLine+1]:lines[current.line];el('stepCount').textContent='Krok '+(s.step+1)+' z '+steps.length+' · '+(current.line===ifLine?'linie '+(ifLine+1)+'–'+(ifLine+2):'linia '+(current.line+1));el('prev').disabled=s.step===0;el('forward').disabled=s.step===steps.length-1;el('traceStatus').textContent=current.line===ifLine?'Sprawdź warunek if. Instrukcja w jego ciele wykona się tylko wtedy, gdy warunek jest prawdziwy.':current.line===(w?3:2)?(s.step===steps.length-2?'Warunek pętli: zakończenie.':'Sprawdzanie warunku pętli '+(w?'while':'for')):current.line===(w?8:6)?'Program wypisuje wynik.':w&&current.line===7?'Zwiększ indeks i o 1.':'Przeanalizuj tę instrukcję i zapisz zmiany w pamięci.';}
function progress(){const count=saved.filter(x=>x.done).length;el('progressText').textContent='Rozwiązane: '+count+' / '+tasks.length;el('bar').style.width=(count/tasks.length*100)+'%';[...el('tasks').children].forEach((b,i)=>b.classList.toggle('done',saved[i].done))}
function render(){const t=tasks[selected],s=saved[selected];el('number').textContent='Pętla '+(selected===0?'while':'for');el('level').textContent=t.level;el('title').textContent=t.title;el('inputData').textContent=t.input;el('fields').replaceChildren();for(const v of Object.keys(t.memory)){const wrap=document.createElement('div'),lab=document.createElement('label'),inp=document.createElement('input');lab.textContent=v+' =';inp.dataset.var=v;inp.value=s.memory[v]||'';inp.placeholder='np. 0, 1, 2';inp.autocomplete='off';wrap.append(lab,inp);el('fields').append(wrap)}el('output').value=s.output;el('result').hidden=true;el('fullSection').hidden=!s.done;el('fullCode').textContent=s.done?t.code:'';el('tasks').replaceChildren();tasks.forEach((x,i)=>{const b=document.createElement('button');b.className='task'+(i===selected?' active':'')+(saved[i].done?' done':'');b.textContent=i===0?'while':'for';b.title=x.title;b.onclick=()=>{persist();selected=i;render()};el('tasks').append(b)});showStep();progress()}
el('prev').onclick=()=>{saved[selected].step=Math.max(0,saved[selected].step-1);showStep()};el('forward').onclick=()=>{saved[selected].step=Math.min(trace(tasks[selected]).length-1,saved[selected].step+1);showStep()};
el('check').onclick=()=>{persist();const t=tasks[selected],s=saved[selected];let good=0;const total=Object.keys(t.memory).length+1,lines=[];for(const [v,answer] of Object.entries(t.memory)){const ok=norm(s.memory[v]||'')===norm(answer);if(ok)good++;lines.push((ok?'✓ ':'✗ ')+v+(ok?' — poprawnie':' — spróbuj ponownie'))}const ok=outNorm(s.output)===outNorm(t.output);if(ok)good++;lines.push((ok?'✓ Output — poprawnie':'✗ Output — spróbuj ponownie'));s.done=good===total;el('result').hidden=false;el('result').textContent=(s.done?'Brawo! Wszystkie odpowiedzi są poprawne. Pełny kod został odblokowany.':'Wynik: '+good+' / '+total+' — popraw błędy, aby zobaczyć cały kod.')+'\n'+lines.join('\n');el('result').className='result '+(s.done?'good':'bad');el('fullSection').hidden=!s.done;el('fullCode').textContent=s.done?t.code:'';progress()};
el('clear').onclick=()=>{saved[selected]={memory:{},output:'',done:false,step:0};render()};render();
</script></body></html>
